<Window x:Class="Lumos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumos"
        Width="436"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Border Margin="18" CornerRadius="11" Background="#12151C" BorderBrush="#343C4E" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.48" Color="#000000"/>
    </Border.Effect>
    <StackPanel>
      <Grid x:Name="Header" Margin="12,12,8,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="{DynamicResource AppMark}" Width="22" Height="22" Margin="2,0,10,0" VerticalAlignment="Center"/>
        <Button x:Name="MonitorButton" Grid.Column="1" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand" Click="MonitorButton_Click" ToolTip="Escolher monitor" AutomationProperties.Name="Escolher monitor">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="Transparent" BorderBrush="#40343C4E" BorderThickness="1"
                      CornerRadius="6" Padding="10,0">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#66343C4E"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="MonitorGlyphHost" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="MonitorLabel" Grid.Column="1" Text="Todos" Margin="8,0" VerticalAlignment="Center"
                       Foreground="#F4F7FB" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <Path Grid.Column="2" Width="10" Height="6" Stretch="Uniform" Stroke="#8E97A6" StrokeThickness="1.6"
                  Data="M1,1 L5,5 L9,1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Grid>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
          <Button x:Name="ProfileButton" Style="{StaticResource IconButton}" Click="ProfileButton_Click" ToolTip="Perfis" AutomationProperties.Name="Perfis">
            <ContentControl x:Name="ProfileGlyphHost" Width="16" Height="16" IsHitTestVisible="False"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Click="SettingsButton_Click" ToolTip="Configurações" AutomationProperties.Name="Configurações">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" Foreground="#D7DDE8"/>
          </Button>
          <ToggleButton x:Name="ExpandButton" Style="{StaticResource IconToggle}" Checked="ExpandChanged" Unchecked="ExpandChanged" ToolTip="Mostrar monitores" AutomationProperties.Name="Mostrar monitores">
            <Path x:Name="ExpandGlyph" Width="12" Height="12" Stretch="Uniform" Stroke="#D7DDE8" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M1,8 L6,4 L11,8 M1,12 L6,8 L11,12"/>
          </ToggleButton>
          <Button Style="{StaticResource IconButton}" Click="CloseButton_Click" ToolTip="Fechar">
            <Path Width="11" Height="11" Stretch="Uniform" Stroke="#D7DDE8" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" Data="M1,1 L10,10 M10,1 L1,10"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Margin="16,12,16,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="36"/>
        </Grid.ColumnDefinitions>
        <RepeatButton x:Name="MinusButton" Grid.Column="0" Style="{StaticResource StepButton}" Content="−" Click="NudgeClick" Tag="-5"/>
        <Slider x:Name="ActiveSlider" Grid.Column="1" Margin="6,0" VerticalAlignment="Center" IsEnabled="False"/>
        <RepeatButton x:Name="PlusButton" Grid.Column="2" Style="{StaticResource StepButton}" Content="+" Click="NudgeClick" Tag="5"/>
        <TextBlock x:Name="ActiveValue" Grid.Column="3" Text="100" Foreground="#F4F7FB" FontWeight="SemiBold"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>

      <TextBlock x:Name="StatusText" Margin="18,0,18,12" Foreground="#E2B15A" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"/>
      <Border x:Name="ListSeparator" Height="1" Background="#2A3142" Margin="16,0,16,0" Visibility="Collapsed"/>
      <StackPanel x:Name="MonitorList" Margin="12,8,12,12" Visibility="Collapsed"/>
    </StackPanel>
  </Border>
</Window>
